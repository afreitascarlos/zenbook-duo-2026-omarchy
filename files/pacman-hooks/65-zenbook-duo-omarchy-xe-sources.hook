# Zenbook Duo (zenbook-duo-omarchy-xe): download the xe/i915 sources of a new Omarchy
# kernel before 70-dkms-install builds the patched xe, so the DKMS build only reads the cache.
# Arch's pacman 7.1 only sandboxes downloads, so hooks have network access, and it rejects
# a 'NetworkAccess' option ("invalid option", the whole transaction fails). install.sh adds
# 'NetworkAccess = allowed' only if the installed libalpm knows that option.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/lib/modules/*/build/include/

[Action]
Description = Fetching xe sources for the Zenbook Duo patched driver...
When = PostTransaction
Depends = git
Exec = /usr/bin/bash -c 'for b in /usr/src/zenbook-duo-omarchy-xe-*/build.sh; do [[ -f $b ]] && exec /usr/bin/bash "$b" --fetch; done; exit 0'
NeedsTargets
